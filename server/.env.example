NODE_ENV=production
PORT=5000

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public

# Auth
JWT_SECRET=replace-with-a-long-random-secret

# Frontend origins. Use your deployed frontend URL here.
CLIENT_URL=https://your-frontend-domain.com
CLIENT_URLS=https://your-frontend-domain.com,https://www.your-frontend-domain.com

# Redis. Prefer REDIS_URL on hosting providers.
REDIS_URL=redis://red-d8cvh5740ujc73c4gjmg:6379
# REDIS_URL=rediss://default:PASSWORD@HOST:PORT

# Email notifications
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password

# Optional SMS
TWILIO_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# First admin account used by npx prisma db seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_USERNAME=admin
ADMIN_FULL_NAME=System Admin
ADMIN_PHONE_NUMBER=+2348012345678
